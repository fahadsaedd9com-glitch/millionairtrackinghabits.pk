# ---- Required in production ----
NODE_ENV=production
# At least 32 random characters. Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Absolute path on a PERSISTENT disk/volume (e.g. /var/data/habits.db). Default: ./data/habits.db
DB_FILE=/var/data/habits.db
# Set automatically by most hosts. Local default: 3000
PORT=3000

# ---- Password-reset emails (optional but needed for real users) ----
# Public URL of the site, used in reset links (required when SMTP_* is set in production).
APP_URL=https://your-app.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Millionaire Tracking Habits <no-reply@example.com>"

# ---- ONLY if the frontend is hosted on a DIFFERENT domain than this server ----
# Comma-separated frontend origins allowed to call the API (no trailing slash).
# CORS_ORIGIN=https://your-site.netlify.app
# Cookie SameSite is "none" automatically when CORS_ORIGIN is set. Override with lax|strict|none.
# COOKIE_SAMESITE=lax
# PUBLIC_API_URL=            # only if this server serves the frontend but the API lives elsewhere

# ---- Optional ----
# TRUST_PROXY=1              # number of reverse proxies in front of the app (default 1 in production)
